{
  "description": "Observe Codex tool lifecycle timing without changing tool behavior.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"$(git rev-parse --show-toplevel)/scripts/codex_hooks/record.py\" --output \"$(git rev-parse --show-toplevel)/.latch/codex-observations.jsonl\"",
            "async": true,
            "timeout": 2
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"$(git rev-parse --show-toplevel)/scripts/codex_hooks/record.py\" --output \"$(git rev-parse --show-toplevel)/.latch/codex-observations.jsonl\"",
            "async": true,
            "timeout": 2
          }
        ]
      }
    ]
  }
}
